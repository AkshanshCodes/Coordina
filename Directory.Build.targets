<Project>
  <PropertyGroup>
    <CoordinaGraphEngineSourceRoot>$(MSBuildThisFileDirectory)src/graph-engine/src</CoordinaGraphEngineSourceRoot>
    <CoordinaGraphEngineSources>$(CoordinaGraphEngineSourceRoot)/interop/coordina_graph_engine.cpp $(CoordinaGraphEngineSourceRoot)/interop/native_bridge.cpp $(CoordinaGraphEngineSourceRoot)/core/graph_snapshot.cpp $(CoordinaGraphEngineSourceRoot)/core/graph_types.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/critical_path.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/dependency_validator.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/graph_traversal.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/node_analysis.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/suggestion_engine.cpp $(CoordinaGraphEngineSourceRoot)/algorithms/topological_order.cpp $(CoordinaGraphEngineSourceRoot)/planning/work_planner.cpp $(CoordinaGraphEngineSourceRoot)/planning/work_score.cpp</CoordinaGraphEngineSources>
    <CoordinaGraphEngineInclude>$(MSBuildThisFileDirectory)src/graph-engine/include</CoordinaGraphEngineInclude>
    <CoordinaGraphEngineOptimization Condition="'$(Configuration)' == 'Debug'">-O0 -g</CoordinaGraphEngineOptimization>
    <CoordinaGraphEngineOptimization Condition="'$(CoordinaGraphEngineOptimization)' == ''">-O2</CoordinaGraphEngineOptimization>
  </PropertyGroup>

  <Target
    Name="BuildCoordinaGraphEngine"
    BeforeTargets="CopyFilesToOutputDirectory"
    Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('$(CoordinaGraphEngineSourceRoot)/interop/coordina_graph_engine.cpp')">
    <Exec Command="g++ -std=c++20 $(CoordinaGraphEngineOptimization) -fPIC -shared -Wall -Wextra -Wpedantic -Werror -I&quot;$(CoordinaGraphEngineInclude)&quot; -I&quot;$(CoordinaGraphEngineSourceRoot)&quot; $(CoordinaGraphEngineSources) -o &quot;$(TargetDir)libcoordina_graph_engine.so&quot;" />
  </Target>

  <Target
    Name="PublishCoordinaGraphEngine"
    BeforeTargets="CopyFilesToPublishDirectory"
    DependsOnTargets="BuildCoordinaGraphEngine"
    Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('$(TargetDir)libcoordina_graph_engine.so')">
    <Copy
      SourceFiles="$(TargetDir)libcoordina_graph_engine.so"
      DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
